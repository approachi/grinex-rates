{
  "__requires__": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "grinex-rates",
  "title": "Grinex Rates",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "GetRates calls per second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (method, status) (rate(grpc_get_rates_total[1m]))",
          "legendFormat": "{{method}} / {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GetRates duration p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (method, le) (rate(grpc_get_rates_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{method}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "GetRates errors per second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (method) (rate(grpc_get_rates_total{status=\"error\"}[1m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "USDT Ask price (USD)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "grinex_rates_ask / 100",
          "legendFormat": "Ask"
        }
      ]
    },
    {
      "id": 4,
      "title": "USDT Bid price (USD)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "grinex_rates_bid / 100",
          "legendFormat": "Bid"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  }
}
